{
  "project": {
    "name": "",
    "slug": "csrinaldi/brain",
    "gitHost": "github.com",
    "gitProjectId": "",
    "owner": ""
  },
  "docs": {
    "language": "en"
  },
  "vcs": {
    "provider": "github",
    "default": "github",
    "providers": {
      "github": {}
    }
  },
  "memory": {
    "backend": "engram",
    "lane": {
      "enabled": true
    },
    "default": "engram",
    "providers": {
      "engram": {}
    }
  },
  "governance": {
    "auditBaseline": "v1.0.0",
    "tier": "lite",
    "ignoreList": [
      "**/*.golden.json",
      "**/*.test.mjs",
      ".memory/**",
      "AGENTS.md",
      "openspec/changes/**",
      "openspec/specs/**",
      "openspec/changes/archive/**",
      "package-lock.json",
      "pnpm-lock.yaml",
      "yarn.lock"
    ],
    "reviewActors": [
      "csrinaldibot"
    ],
    "agentActors": [
      "claude"
    ]
  },
  "reviewer": {
    "handle": "csrinaldibot",
    "tokenEnv": "BRAIN_REVIEWER_TOKEN",
    "protocol": "brain-review/2"
  },
  "schemaVersion": "0.3.0",
  "sdd": {
    "map": {
      "cold-review": {
        "engine": "codex",
        "model": "gpt-5.5"
      }
    },
    "default": "gentle-ai",
    "providers": {
      "gentle-ai": {},
      "brain": {
        "version": "self"
      }
    },
    "roles": {
      "cold-review": {
        "agent": "brain:cold-review",
        "engine": "codex",
        "model": "gpt-5.5"
      }
    }
  },
  "platform": {
    "default": "claude",
    "providers": {
      "claude": {},
      "codex": {}
    }
  }
}
